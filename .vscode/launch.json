{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug V-Pet Tamers",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/VPetTamers.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "C:\\mingw64\\bin;${env:PATH}"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/mingw64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Ativar Pretty Printing no GDB",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "[CPP] Make"
    }
  ]
}